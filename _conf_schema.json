{
  "selected_video_provider": {
    "description": "视频供应商（可填内置名或自定义名）",
    "type": "string",
    "hint": "内置示例：zhipu、seedance；也可填写 custom_video_providers_json 中的 name",
    "default": "zhipu"
  },
  "selected_image_provider": {
    "description": "生图供应商（可填内置名或自定义名）",
    "type": "string",
    "hint": "内置示例：zhipu、openai_image；也可填写 custom_image_providers_json 中的 name",
    "default": "zhipu"
  },
  "default_video_provider": {
    "description": "兼容旧配置：默认视频供应商",
    "type": "string",
    "default": "zhipu"
  },
  "default_image_provider": {
    "description": "兼容旧配置：默认生图供应商",
    "type": "string",
    "default": "zhipu"
  },
  "custom_image_providers_json": {
    "description": "自定义生图供应商(JSON数组)",
    "type": "string",
    "hint": "示例: [{\"name\":\"myimg\",\"api_key\":\"sk-xxx\",\"api_base\":\"https://api.example.com/v1\",\"generate_path\":\"/images/generations\",\"model\":\"model-name\"}]",
    "default": "[]"
  },
  "custom_video_providers_json": {
    "description": "自定义视频供应商(JSON数组)",
    "type": "string",
    "hint": "示例: [{\"name\":\"myvideo\",\"api_key\":\"sk-xxx\",\"api_base\":\"https://api.example.com/v1\",\"submit_path\":\"/generate\",\"query_path\":\"/status\",\"task_id_paths\":[\"data.task_id\"],\"status_paths\":[\"data.status\"],\"video_url_paths\":[\"data.url\"]}]",
    "default": "[]"
  },
  "webui_auto_start": {
    "description": "插件加载时自动启动WebUI",
    "type": "bool",
    "default": false
  },
  "webui_host": {
    "description": "WebUI监听地址",
    "type": "string",
    "hint": "默认 127.0.0.1，仅本机访问；如需局域网访问可改为 0.0.0.0",
    "default": "127.0.0.1"
  },
  "webui_port": {
    "description": "WebUI端口",
    "type": "int",
    "default": 8765
  },
  "zhipu_api_key": {
    "description": "智谱 API Key",
    "type": "string",
    "default": "",
    "obvious_hint": true
  },
  "zhipu_api_base": {
    "description": "智谱 API Base",
    "type": "string",
    "hint": "默认 https://open.bigmodel.cn/api/paas/v4",
    "default": "https://open.bigmodel.cn/api/paas/v4"
  },
  "zhipu_video_model": {
    "description": "智谱视频模型",
    "type": "string",
    "default": "CogVideoX-Flash"
  },
  "zhipu_image_model": {
    "description": "智谱生图模型",
    "type": "string",
    "default": "glm-image"
  },
  "zhipu_video_with_audio": {
    "description": "智谱视频是否带音频",
    "type": "bool",
    "default": true
  },
  "seedance_api_key": {
    "description": "Seedance API Key（豆包）",
    "type": "string",
    "default": ""
  },
  "seedance_api_base": {
    "description": "Seedance API Base",
    "type": "string",
    "hint": "默认 https://seedanceapi.org/v1",
    "default": "https://seedanceapi.org/v1"
  },
  "seedance_generate_path": {
    "description": "Seedance 提交任务路径",
    "type": "string",
    "default": "/generate"
  },
  "seedance_status_path": {
    "description": "Seedance 查询任务路径",
    "type": "string",
    "default": "/status"
  },
  "seedance_video_model": {
    "description": "Seedance 视频模型（可选）",
    "type": "string",
    "default": ""
  },
  "seedance_resolution": {
    "description": "Seedance 分辨率",
    "type": "string",
    "default": "1080p"
  },
  "seedance_duration": {
    "description": "Seedance 时长（秒）",
    "type": "int",
    "default": 5
  },
  "seedance_aspect_ratio": {
    "description": "Seedance 画幅比例",
    "type": "string",
    "default": "16:9"
  },
  "seedance_generate_audio": {
    "description": "Seedance 是否生成音频",
    "type": "bool",
    "default": true
  },
  "seedance_fixed_lens": {
    "description": "Seedance 是否固定镜头",
    "type": "bool",
    "default": false
  },
  "openai_image_api_key": {
    "description": "OpenAI兼容生图 API Key",
    "type": "string",
    "default": ""
  },
  "openai_image_api_base": {
    "description": "OpenAI兼容生图 API Base",
    "type": "string",
    "hint": "例如 https://api.openai.com/v1 或兼容服务地址",
    "default": ""
  },
  "openai_image_generate_path": {
    "description": "OpenAI兼容生图路径",
    "type": "string",
    "default": "/images/generations"
  },
  "openai_image_edit_path": {
    "description": "OpenAI兼容图生图路径（可选）",
    "type": "string",
    "default": ""
  },
  "openai_image_model": {
    "description": "OpenAI兼容生图模型",
    "type": "string",
    "default": "gpt-image-1"
  },
  "default_image_size": {
    "description": "生图默认尺寸",
    "type": "string",
    "default": "1024x1024"
  },
  "default_i2v_prompt": {
    "description": "图生视频默认提示词",
    "type": "string",
    "default": "让画面自然地动起来"
  },
  "default_i2i_prompt": {
    "description": "图生图默认提示词",
    "type": "string",
    "default": "保持主体结构，优化细节和质感"
  },
  "request_timeout_seconds": {
    "description": "请求超时时间（秒）",
    "type": "int",
    "default": 90
  },
  "request_retry_count": {
    "description": "请求重试次数",
    "type": "int",
    "default": 1
  },
  "download_timeout_seconds": {
    "description": "下载超时时间（秒）",
    "type": "int",
    "default": 120
  },
  "min_request_interval_seconds": {
    "description": "同一用户最小请求间隔（秒）",
    "type": "float",
    "default": 3
  },
  "max_image_size_mb": {
    "description": "最大图片体积（MB）",
    "type": "int",
    "default": 10
  },
  "max_video_size_mb": {
    "description": "最大视频体积（MB）",
    "type": "int",
    "default": 100
  },
  "save_video_local": {
    "description": "本地缓存视频",
    "type": "bool",
    "default": false
  },
  "save_image_local": {
    "description": "本地缓存图片",
    "type": "bool",
    "default": false
  },
  "return_video_url": {
    "description": "返回视频URL",
    "type": "bool",
    "default": true
  },
  "return_image_url": {
    "description": "返回图片URL",
    "type": "bool",
    "default": true
  },
  "attach_video_result": {
    "description": "附带视频消息",
    "type": "bool",
    "default": true
  },
  "attach_image_result": {
    "description": "附带图片消息",
    "type": "bool",
    "default": true
  },
  "max_cache_files": {
    "description": "缓存文件数量上限",
    "type": "int",
    "default": 20
  }
}
